# Public origin of the deployment, no trailing slash.
# Used for canonical URLs, Open Graph and the sitemap.
NEXT_PUBLIC_SITE_URL=https://dartawil.emsquare.ma

# Search engine indexing. Leave as "false" for the client preview —
# set to "true" only for the real public launch.
SITE_INDEXABLE=false

# Back office (/gestion). Postgres connection string — in Coolify, create a
# PostgreSQL resource and paste its internal URL. Runtime variable, not build.
DATABASE_URL=postgres://user:password@localhost:5432/dar_tawil
